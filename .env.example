# ==============================================================================
# RetailMind AI — Environment Configuration Template
# DO NOT commit real API keys or sensitive secrets to version control.
# Copy this file to .env and provide your actual values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (Google Gemini API)
# ------------------------------------------------------------------------------
# Required: Your Google Gemini API Key from Google AI Studio
# Sign up / get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model ID: Must use an official Google Gemini model ID
# Primary default: gemini-2.5-flash
# Alternative: gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Agent Loop Guardrails & Limits (Capstone Contract)
# ------------------------------------------------------------------------------
# Maximum reasoning loop turns before termination
MAX_TURNS=8

# Dollar-denominated budget cap per single task (in USD)
BUDGET_PER_TASK_USD=0.10

# Permission policy: 'auto' | 'ask_on_write' | 'always_ask'
# Default: ask_on_write (analysis runs auto; generate_report requires explicit user approval)
PERMISSION_POLICY=ask_on_write

# ------------------------------------------------------------------------------
# 3. Storage and Persistence
# ------------------------------------------------------------------------------
# SQLite database path for persistent episodic memory and audit logs
SQLITE_DB_PATH=data/retailmind.db

# Directory for approved generated reports
REPORTS_DIR=reports

# ------------------------------------------------------------------------------
# 4. App & Environment Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
